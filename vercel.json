{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.go"
    },
    {
      "src": "^/api/?$",
      "dest": "/api/index.go"
    },
    {
      "src": "^/api/foam/generate-dict/?$",
      "dest": "/api/foam/generate.go"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1.go"
    }
  ]
}
